<div class="min-h-screen bg-slate-950 text-white font-sans antialiased selection:bg-blue-500 selection:text-white">
  <!-- Nav Bar -->
  <header class="sticky top-0 z-50 px-4 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between backdrop-blur-md bg-slate-900/60 border border-white/10 rounded-2xl px-6 py-3 shadow-lg">
      <div class="flex items-center space-x-3">
        <!-- Logo -->
        <div class="w-10 h-10 bg-gradient-to-tr from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-md shadow-blue-500/30">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </div>
        <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-blue-400 via-indigo-200 to-white bg-clip-text text-transparent">Blue Bird</span>
      </div>

      <!-- Nav Links -->
      <nav class="hidden md:flex space-x-8 text-sm font-medium text-slate-300">
        <a href="<%= lang === 'es' ? '/es/' : '/' %>" class="hover:text-blue-400 transition-colors"><%= t('home_link') %></a>
        <a href="<%= lang === 'es' ? '/es/about' : '/about' %>" class="hover:text-blue-400 transition-colors"><%= t('about_link') %></a>
      </nav>

      <!-- Language selector -->
      <div class="flex items-center space-x-2 bg-slate-900 border border-white/10 rounded-xl p-1 text-sm font-semibold">
        <a href="/en<%= req.originalUrl.replace(/^\/(en|es)/, '') %>" class="px-3 py-1.5 rounded-lg transition-all <%= lang === 'en' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white' %>">
          EN
        </a>
        <a href="/es<%= req.originalUrl.replace(/^\/(en|es)/, '') %>" class="px-3 py-1.5 rounded-lg transition-all <%= lang === 'es' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white' %>">
          ES
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="max-w-7xl mx-auto px-4 pt-12 pb-24">
    <div class="relative py-16 px-6 md:px-12 rounded-3xl overflow-hidden bg-gradient-to-b from-blue-900/20 to-slate-950 border border-white/5 shadow-2xl">
      <!-- Background glow effects -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
      <div class="absolute -right-40 -bottom-40 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl"></div>

      <div class="relative max-w-4xl mx-auto text-center space-y-8">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase">
          <%= t('title') %>
        </span>
        
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight bg-gradient-to-r from-blue-400 via-indigo-300 to-white bg-clip-text text-transparent">
          <%= t('welcome_msg', { name: 'Developer' }) %>
        </h1>
        
        <p class="text-lg sm:text-xl text-slate-400 leading-relaxed max-w-2xl mx-auto">
          <%= t('description') %>
        </p>

        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="<%= lang === 'es' ? '/es/about' : '/about' %>" class="px-8 py-3.5 rounded-xl font-semibold bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 shadow-lg shadow-blue-500/20 transform hover:-translate-y-0.5 transition-all">
            <%= t('about') %> &rarr;
          </a>
          <a href="https://github.com/seip25/Blue-bird" target="_blank" class="px-8 py-3.5 rounded-xl font-semibold bg-slate-900 border border-white/10 hover:bg-slate-800 transition-all">
            GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Core Features Grid -->
    <section class="mt-24 space-y-12">
      <div class="text-center space-y-3">
        <h2 class="text-3xl font-bold bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">Built-in Premium Features</h2>
        <p class="text-slate-400">Everything preconfigured to get you up and running immediately.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1: EJS -->
        <div class="group relative p-8 rounded-2xl bg-slate-900/40 border border-white/5 hover:border-blue-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-1">
          <div class="w-12 h-12 bg-blue-500/10 text-blue-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3 group-hover:text-blue-400 transition-colors">EJS Engine & Layout</h3>
          <p class="text-sm text-slate-400 leading-relaxed">Structured layout wrapping and dynamic variable rendering for cleaner pages with zero setup.</p>
        </div>

        <!-- Feature 2: i18n -->
        <div class="group relative p-8 rounded-2xl bg-slate-900/40 border border-white/5 hover:border-blue-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-1">
          <div class="w-12 h-12 bg-indigo-500/10 text-indigo-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 0c-.83-1.891-2.194-3.578-3.8-4.869M19 19H5.05a9 9 0 011.66-5.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3 group-hover:text-indigo-400 transition-colors">Automatic Translation</h3>
          <p class="text-sm text-slate-400 leading-relaxed">Full internationalization supporting route rewriting, cookies, request headers, and custom t() dictionary helper.</p>
        </div>

        <!-- Feature 3: Cache -->
        <div class="group relative p-8 rounded-2xl bg-slate-900/40 border border-white/5 hover:border-blue-500/30 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-1">
          <div class="w-12 h-12 bg-teal-500/10 text-teal-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3 group-hover:text-teal-400 transition-colors">Performance Cache</h3>
          <p class="text-sm text-slate-400 leading-relaxed">Unified memory caching middleware that accelerates HTML views and REST API JSON payloads natively.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 py-8 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-500">
      <p><%= t('footer') %></p>
    </div>
  </footer>
</div>
