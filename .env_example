# Server and Application Configuration
DEBUG=true
PORT=3000
HOST="localhost"
APP_URL="http://localhost"
VERSION="1.0.0"

# Docker / Swagger Config
COMPOSE_PROJECT_NAME="blue-bird"
TITLE="Blue-Bird"
DESCRIPTION="Description project"

# Security Configuration
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Cache Configuration
# Options: "memory" (in-process LRU), "redis" (distributed), "none" (disabled)
CACHE_MODE="memory"
CACHE_MAX_KEYS=1000

# Redis Configuration (used when CACHE_MODE="redis")
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# PM2 Clustering Instances (integer or 'max')
# Single instance: SQLite + memory cache work well.
# Multiple instances: use MySQL/PostgreSQL and CACHE_MODE=redis.
PM2_INSTANCES=1

# Render Cache TTL in seconds (default: 300)
RENDER_CACHE_TTL=300
RENDER_CACHE_MAX=500

# Database Configuration
# SQLite (Default — uses WAL mode, busy timeout, and memory-mapped I/O automatically)
DB_TYPE="sqlite"
DB_FILE="database/blue_bird.db"
DATABASE_URL="sqlite:database/blue_bird.db"

# MySQL (Uncomment to use MySQL in Docker or locally)
# DB_TYPE="mysql"
# DB_NAME="blue_bird"
# DB_USER="root"
# DB_PASSWORD="root"
# DB_PORT=3306
# DATABASE_URL="mysql://root:root@localhost:3306/blue_bird"

# PostgreSQL (Uncomment to use PostgreSQL in Docker or locally)
# DB_TYPE="postgres"
# DB_NAME="blue_bird"
# DB_USER="postgres"
# DB_PASSWORD="root"
# DB_PORT=5432
# DATABASE_URL="postgresql://postgres:root@localhost:5432/blue_bird?schema=public"