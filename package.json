{
  "name": "@seip/blue-bird",
  "version": "2.0.0",
  "description": "Performance-first Node.js API and web framework with built-in JWT auth, HTML rendering, validation, and multi-level caching",
  "type": "module",
  "types": "core/index.d.ts",
  "exports": {
    "./*": "./*"
  },
  "bin": {
    "blue-bird": "core/cli/init.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seip25/Blue-bird.git"
  },
  "keywords": [
    "express",
    "framework",
    "html",
    "api",
    "jwt",
    "render",
    "seo"
  ],
  "author": "Seip25",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seip25/Blue-bird/issues"
  },
  "homepage": "https://seip25.github.io/Blue-bird/",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env app/index.js",
    "start": "node --env-file=.env app/index.js",
    "init": "blue-bird",
    "doctor": "blue-bird doctor",
    "route": "blue-bird make:route",
    "view": "blue-bird make:view",
    "migrate": "blue-bird migrate",
    "seed": "blue-bird seed",
    "ecosystem": "blue-bird make:ecosystem",
    "swagger-install": "blue-bird swagger-install",
    "docker": "blue-bird docker",
    "test": "node test/test_suite.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "core",
    "app",
    "public",
    "docker",
    "docker-compose.yml",
    "AGENTS.md",
    ".env_example",
    "jsconfig.json",
    ".vscode"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "redis": "^6.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "ejs": "^3.1.10",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "ws": "^8.18.0",
    "express-rate-limit": "^8.2.1"
  }
}